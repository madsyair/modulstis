% ---------- Penomoran Contoh, Kode, Latihan, Tugas ----------
\newcounter{contohctr}
\newcommand{\contoh}[1]{%
  \refstepcounter{contohctr}%
  \par\vspace{12pt}%
  \noindent\begin{tcolorbox}[enhanced, colback=bpsoranye!12, colframe=bpsoranye,
    boxrule=0pt, leftrule=5pt, arc=2pt, left=9pt, right=9pt, top=4pt, bottom=4pt]
  \sffamily\bfseries\color{bpsnavy}Contoh \nomormodul.\arabic{contohctr}%
  \textcolor{bpsoranye}{\ \ $\vert$\ \ }#1
  \end{tcolorbox}\par\vspace{2pt}\nopagebreak}

\newcounter{kodectr}
\newcommand{\kode}[2][R]{%
  \refstepcounter{kodectr}%
  \par\vspace{8pt}\nopagebreak
  \def\lblbahasa{#1}%
  \ifx\lblbahasa\bahasaPython
    \noindent\colorbox{pykuning}{\textcolor{white}{\sffamily\bfseries\small\;Kode \nomormodul.\arabic{kodectr} · Python\;}}%
  \else
    \noindent\colorbox{bpsbiru}{\textcolor{white}{\sffamily\bfseries\small\;Kode \nomormodul.\arabic{kodectr} · R\;}}%
  \fi
  \;{\small\bfseries\color{bpsnavy}#2}%
  \par\vspace{-3pt}\nopagebreak}
\def\bahasaPython{Python}

\newcounter{latihanctr}
\newcommand{\latihan}[1]{%
  \refstepcounter{latihanctr}%
  \par\vspace{12pt}%
  \noindent\begin{tcolorbox}[enhanced, colback=bpshijau!12, colframe=bpshijau,
    boxrule=0pt, leftrule=5pt, arc=2pt, left=9pt, right=9pt, top=4pt, bottom=4pt]
  \sffamily\bfseries\color{bpsnavy}Latihan \nomormodul.\arabic{latihanctr}%
  \textcolor{bpshijau!60!black}{\ \ $\vert$\ \ }#1
  \end{tcolorbox}\par\vspace{2pt}\nopagebreak}

\newcounter{tugasctr}
\newcommand{\tugas}[1]{%
  \refstepcounter{tugasctr}%
  \par\vspace{10pt}%
  \noindent\begin{tcolorbox}[enhanced, colback=bpsnavy!8, colframe=bpsnavy,
    boxrule=0pt, leftrule=5pt, arc=2pt, left=9pt, right=9pt, top=4pt, bottom=4pt]
  \sffamily\bfseries\color{bpsnavy}Tugas \nomormodul.\arabic{tugasctr}%
  \textcolor{bpsnavy}{\ \ $\vert$\ \ }#1
  \end{tcolorbox}\par\vspace{2pt}\nopagebreak}

