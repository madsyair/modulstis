% ---------- Gaya judul ----------
\titleformat{\section}[hang]
  {\sffamily\bfseries\Large\color{bpsnavy}}{\thesection}{0.6em}{}
  [{\vspace{1pt}{\color{bpsoranye}\titlerule[1.6pt]}}]
\titlespacing*{\section}{0pt}{18pt}{8pt}

\titleformat{\subsection}[hang]
  {\sffamily\bfseries\large\color{bpsbiru}}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{13pt}{4pt}

\titleformat{\subsubsection}[hang]
  {\sffamily\bfseries\normalsize\color{bpsnavy}}{\thesubsubsection}{0.5em}{}
\titlespacing*{\subsubsection}{0pt}{10pt}{3pt}

% Judul tingkat empat dan lima. Tanpa format ini, titlesec berhenti dengan
% galat "No format for this command" ketika dokumen memuat judul '####'.
% Bookdown jarang memunculkannya, tetapi Quarto memetakannya ke \paragraph.
\titleformat{\paragraph}[hang]
  {\sffamily\bfseries\normalsize\color{bpsnavy}}{\theparagraph}{0.6em}{}
\titlespacing*{\paragraph}{0pt}{9pt}{3pt}
\titleformat{\subparagraph}[hang]
  {\sffamily\bfseries\small\color{bpsnavy}}{\thesubparagraph}{0.6em}{}
\titlespacing*{\subparagraph}{0pt}{8pt}{3pt}

