% \istilahitem{istilah}{inggris}{definisi}
\newcommand{\istilahitem}[3]{%
  \noindent\textbf{\color{bpsnavy}#1}%
  \ifx\relax#2\relax\else\ {\small\color{abuteks}(#2)}\fi\ \textemdash\ #3\par
  \vspace{3pt}}
