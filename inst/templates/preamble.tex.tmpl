% ---------- Halaman cover pembatas ----------
% \coverpembatas[BADGE]{nomor}{judul}{pertemuan}{sub-cpmk}
\newcommand{\coverpembatas}[5][]{%
  \begin{titlepage}
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[white] (current page.south west) rectangle (current page.north east);
    % pita diagonal atas
    \fill[bpsnavy] (current page.north west) -- ++(0,-7.4cm) --
      ($(current page.north east)+(0,-4.4cm)$) -- (current page.north east) -- cycle;
    \fill[bpsbiru, opacity=0.9] (current page.north west) -- ++(0,-5.5cm) --
      ($(current page.north east)+(0,-2.7cm)$) -- (current page.north east) -- cycle;
    % ornamen
    \fill[bpsoranye, opacity=0.13] ($(current page.east)+(-1.6cm,1.2cm)$) circle (3.9cm);
    \fill[bpshijau, opacity=0.10] ($(current page.south east)+(-4.6cm,3.0cm)$) circle (2.6cm);
    % pita bawah
    \fill[bpsnavy] (current page.south west) rectangle ($(current page.south east)+(0,1.6cm)$);
    \fill[bpsoranye] ($(current page.south west)+(0,1.6cm)$) rectangle ($(current page.south east)+(0,1.78cm)$);
    % tiga blok warna BPS
    \fill[bpsbiru]   ($(current page.south west)+(2.5cm,2.7cm)$) rectangle ++(2.2cm,0.26cm);
    \fill[bpsoranye] ($(current page.south west)+(4.9cm,2.7cm)$) rectangle ++(2.2cm,0.26cm);
    \fill[bpshijau]  ($(current page.south west)+(7.3cm,2.7cm)$) rectangle ++(2.2cm,0.26cm);
    % identitas institusi
    \node[anchor=north west, text=white, align=left]
      at ($(current page.north west)+(2.5cm,-1.7cm)$)
      {\sffamily\Large POLITEKNIK STATISTIKA STIS\\[3pt]
       \sffamily\normalsize Program Studi @@PRODI@@};
    \node[anchor=north west, text=white, align=left]
      at ($(current page.north west)+(2.5cm,-3.7cm)$)
      {\sffamily\small MODUL PRAKTIKUM \ \textbullet\ \ @@MATKULBESAR@@ (@@KODEMK@@)};
    % blok nomor modul
    \fill[bpsoranye] ($(current page.west)+(2.5cm,2.0cm)$) rectangle ++(0.18cm,3.7cm);
    \node[anchor=north west, text=bpsnavy] at ($(current page.west)+(3.0cm,5.75cm)$)
      {\sffamily\bfseries\fontsize{20}{22}\selectfont MODUL};
    \node[anchor=north west, text=bpsnavy] at ($(current page.west)+(2.9cm,4.85cm)$)
      {\sffamily\bfseries\fontsize{78}{78}\selectfont #2};
    % judul modul
    % Font ditetapkan lewat opsi 'font=' agar TikZ memakai baselineskip yang
    % benar. Bila ditulis di dalam badan node, TikZ sudah mengunci jarak baris
    % dari font luar sehingga judul tiga baris saling bertindih.
    \node[anchor=north west, text=bpsnavy, align=left, text width=14.5cm,
          font=\sffamily\bfseries\fontsize{28}{33}\selectfont]
      at ($(current page.west)+(2.5cm,1.5cm)$)
      {\hyphenchar\font=-1 #3};
    % badge opsional
    \node[anchor=north west] at ($(current page.west)+(2.5cm,-2.4cm)$)
      {\ifx\relax#1\relax\else\colorbox{bpshijau}{\textcolor{white}{\sffamily\bfseries\ #1\ }}\fi};
    % keterangan
    \node[anchor=north west, text=abuteks, align=left, text width=13.5cm]
      at ($(current page.west)+(2.5cm,-3.4cm)$)
      {\sffamily\large\bfseries #4\\[7pt]
       \sffamily\normalsize\justifying #5};
    % penyusun
    \node[anchor=west, text=abuteks, align=left]
      at ($(current page.south west)+(2.5cm,3.55cm)$)
      {\sffamily\footnotesize\textbf{Penyusun:}\ \ @@PENYUSUN@@};
    % teks pita bawah
    \node[anchor=west, text=white] at ($(current page.south west)+(2.5cm,0.8cm)$)
      {\sffamily\small Semester @@SEMESTER@@};
  \end{tikzpicture}
  \end{titlepage}%
  % penomoran berlanjut lintas modul (buku gabungan)
  \setcounter{page}{@@HALAWAL@@}}
