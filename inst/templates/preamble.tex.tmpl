% ---------- Penomoran mengikuti nomor modul ----------
\newcommand{\nomormodul}{@@NOMOR@@}
\renewcommand{\thesection}{\nomormodul.\arabic{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
